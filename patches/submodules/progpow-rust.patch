+// Frees everything that holds GPU memory. Never throws: it also runs after a failure.
+void CLMiner::releaseResources()
+{
+	try
+	{
+		if (m_queue())
+			m_queue.finish();
+	}
+	catch (...) {}
+	try
+	{
+		m_searchKernel = cl::Kernel();

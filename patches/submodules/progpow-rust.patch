+		++s_failed;
+	}
+	std::cerr << "ProgPoW: GPU " << index << " stopped: " << reason << std::endl;
+	if (s_failed.load() >= s_created.load())
+	{
+		std::cerr << "ProgPoW: no GPU can mine, exiting" << std::endl;
+		std::_Exit(1);
+	}
+	std::cerr << "ProgPoW: other GPUs keep mining, GPU " << index << " retries in 5 minutes" << std::endl;
 }
 

diff --git a/pp_full/build.rs b/pp_full/build.rs
index 3dd42b1..288df61 100644
--- a/pp_full/build.rs
+++ b/pp_full/build.rs
@@ -47,7 +47,44 @@ fn compile_cmake() {
 		make.define("ETHASHCL", "OFF");
 	}
 
-	make.build_target("").build();
+	// Hunter (2018) downloads its packages from dead mirrors: use system Boost/OpenCL unless
+	// PROGPOW_HUNTER=1 is set.
+	if env::var("PROGPOW_HUNTER").map(|v| v != "1").unwrap_or(true) {
+		make.define("HUNTER_ENABLED", "OFF");
+	}
+
+	// cmake 0.1.42 does not know Visual Studio 2022: the generator can be given explicitly.
+	let explicit_generator = env::var("PROGPOW_CMAKE_GENERATOR").ok();
+	if let Some(generator) = &explicit_generator {
+		make.generator(generator);
+	}
+
+	// Rust links the CRT statically on Windows (-C target-feature=+crt-static): /MT for C++ too.
+	if env::var("CARGO_CFG_TARGET_FEATURE").map(|f| f.contains("crt-static")).unwrap_or(false) {
+		make.static_crt(true);
+		// With an explicit generator the cmake crate no longer sets the per-config flags.
+		if explicit_generator.is_some() && env::var("CARGO_CFG_TARGET_ENV").map(|e| e == "msvc").unwrap_or(false) {
+			make.define("CMAKE_C_FLAGS_RELEASE", "/MT /O2 /Ob2 /DNDEBUG");
+			make.define("CMAKE_CXX_FLAGS_RELEASE", "/MT /O2 /Ob2 /DNDEBUG");
+		}
+	}
+
+	// Locations of system packages (Windows CI: vcpkg Boost, Khronos OpenCL SDK).
+	for name in &[
+		"CMAKE_TOOLCHAIN_FILE",
+		"VCPKG_TARGET_TRIPLET",
+		"OpenCL_INCLUDE_DIR",
+		"OpenCL_LIBRARY",
+		"BOOST_ROOT",
+	] {
+		if let Ok(value) = env::var(name) {
+			make.define(name, value);
+		}
+	}
+
+	// Visual Studio names the "build everything" target ALL_BUILD.
+	let msvc = env::var("CARGO_CFG_TARGET_ENV").map(|e| e == "msvc").unwrap_or(false);
+	make.build_target(if msvc { "ALL_BUILD" } else { "all" }).build();
 }
 

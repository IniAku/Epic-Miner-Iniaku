+		m_dag = cl::Buffer();
+		m_light = cl::Buffer();
+		m_header = cl::Buffer();
+		m_searchBuffer = cl::Buffer();
+		m_queue = cl::CommandQueue();
+		m_context = cl::Context();
+	}
+	catch (...) {}
+}
+
+void CLMiner::deviceFailed(std::string const& reason)
+{
+	releaseResources();
+	m_ready = false;
+	m_retryAt = std::chrono::steady_clock::now() + std::chrono::minutes(5);
+	if (!m_countedFailed)
+	{
+		m_countedFailed = true;
+		++s_failed;
+	}
+	std::cerr << "ProgPoW: GPU " << index << " stopped: " << reason << std::endl;
+	if (s_failed.load() >= s_created.load())
+	{
+		std::cerr << "ProgPoW: no GPU can mine, exiting" << std::endl;
+		std::_Exit(1);
+	}
+	std::cerr << "ProgPoW: other GPUs keep mining, GPU " << index << " retries in 5 minutes" << std::endl;
+}
+
+void CLMiner::deviceRecovered()
+{
+	m_ready = true;
+	if (m_countedFailed)
+	{
+		m_countedFailed = false;
+		--s_failed;
+		std::cerr << "ProgPoW: GPU " << index << " is mining again" << std::endl;
+	}
 }
 

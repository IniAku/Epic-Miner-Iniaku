# Builder rilis Linux: Ubuntu 20.04 (glibc 2.31) supaya binary jalan di HiveOS & Ubuntu 20.04+.
FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git curl ca-certificates pkg-config perl \
      libssl-dev libncursesw5-dev ocl-icd-opencl-dev opencl-headers clang libclang-dev wget gnupg \
 && rm -rf /var/lib/apt/lists/*
# CUDA 12.4 (repo NVIDIA ubuntu2004); runtime ter-link statis di plugin, user cukup driver.
RUN wget -q https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2004/x86_64/cuda-keyring_1.1-1_all.deb \
 && dpkg -i cuda-keyring_1.1-1_all.deb && rm cuda-keyring_1.1-1_all.deb \
 && apt-get update && apt-get install -y --no-install-recommends cuda-nvcc-12-4 cuda-cudart-dev-12-4 \
 && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
ENV PATH=/usr/local/cuda-12.4/bin:/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.99.1 --no-modify-path \
 && chmod -R a+rX /opt/rustup /opt/cargo
# ProgPoW (progpow-rust/pp_full): system Boost instead of Hunter
RUN apt-get update && apt-get install -y --no-install-recommends libboost-dev libboost-system-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src

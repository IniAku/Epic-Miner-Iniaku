+std::string lowerCase(std::string s)
+{
+	for (auto& c: s)
+		c = static_cast<char>(tolower(static_cast<unsigned char>(c)));
+	return s;
+}
+
+// IniAku: choose the OpenCL platform instead of always taking the first one. On rigs
+// with an integrated Intel GPU the Intel platform often comes first, and every device
+// number then wrapped onto the iGPU. INIAKU_OCL_PLATFORM = index or part of the
+// platform name/vendor ("NVIDIA", "AMD", "Intel") overrides the automatic choice:
+// first platform with an NVIDIA/AMD GPU, then any platform with a GPU, then 0.
+unsigned pickPlatform(std::vector<cl::Platform> const& _platforms, unsigned _requested)
+{
+	auto label = [&](size_t i) {
+		std::string name, vendor;
+		try { name = _platforms[i].getInfo<CL_PLATFORM_NAME>(); } catch (...) {}
+		try { vendor = _platforms[i].getInfo<CL_PLATFORM_VENDOR>(); } catch (...) {}
+		return name + " / " + vendor;
+	};
+	auto gpuCount = [&](size_t i) {
+		try { return getDevices(_platforms, static_cast<unsigned>(i)).size(); } catch (...) { return size_t(0); }
+	};
+
+	const char* env = getenv("INIAKU_OCL_PLATFORM");
+	std::string sel = env ? std::string(env) : std::string();
+	if (!sel.empty() && lowerCase(sel) != "auto")
+	{
+		if (sel.find_first_not_of("0123456789") == std::string::npos)
+		{
+			unsigned i = static_cast<unsigned>(std::stoul(sel));
+			if (i < _platforms.size())
+				return i;
+			std::cerr << "ProgPoW: INIAKU_OCL_PLATFORM=" << sel << " is out of range (" << _platforms.size() << " platforms), choosing automatically" << std::endl;
+		}
+		else
+		{
+			for (size_t i = 0; i < _platforms.size(); i++)
+				if (lowerCase(label(i)).find(lowerCase(sel)) != std::string::npos)
+					return static_cast<unsigned>(i);
+			std::cerr << "ProgPoW: no OpenCL platform matches INIAKU_OCL_PLATFORM=" << sel << ", choosing automatically" << std::endl;
+		}
+	}
+	else if (_requested != 0 && _requested < _platforms.size())
+		return _requested;
+
+	for (size_t i = 0; i < _platforms.size(); i++)
+	{
+		std::string l = lowerCase(label(i));
+		bool discrete = l.find("nvidia") != std::string::npos || l.find("amd") != std::string::npos
+			|| l.find("advanced micro") != std::string::npos;
+		if (discrete && gpuCount(i) > 0)
+			return static_cast<unsigned>(i);
+	}
+	for (size_t i = 0; i < _platforms.size(); i++)
+		if (gpuCount(i) > 0)
+			return static_cast<unsigned>(i);
+	return 0;
+}
+
 }
 
 }
